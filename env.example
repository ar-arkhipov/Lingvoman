# Required Environment Variables for Lingvoman Serverless Deployment

# Database Configuration
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/lingvoman?retryWrites=true&w=majority

# Security Configuration
JWT_SECRET=your-super-secure-jwt-secret-at-least-32-characters-long

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Logging Configuration
LOG_LEVEL=info

# CORS Configuration (optional)
ALLOWED_ORIGINS=https://your-frontend-domain.com,https://lingvoman-frontend.s3-website-us-east-1.amazonaws.com

# Server Configuration (optional)
NODE_ENV=production 