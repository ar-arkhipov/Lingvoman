{
  "name": "lingvoman",
  "version": "1.0.0",
  "description": "Simple system to store, serve and redact translations for site",
  "main": "app.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "dotenv": "17.2.0",
    "express": "4.21.2",
    "gulp": "5.0.1",
    "gulp-concat": "2.6.1",
    "gulp-ng-annotate": "^0.2.0",
    "gulp-uglify": "3.0.2",
    "jsonwebtoken": "9.0.2",
    "method-override": "3.0.0",
    "mongoose": "8.12.0",
    "morgan": "1.10.0",
    "nconf": "0.12.1",
    "winston": "3.17.0"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "node lingvoman.js",
    "start:dev": "NODE_ENV=development node -r dotenv/config lingvoman.js",
    "start:prod": "NODE_ENV=production node lingvoman.js",
    "build": "cd public && npx gulp js",
    "build:watch": "cd public && npx gulp watch",
    "build:clean": "cd public && rm -f js/app.js",
    "dev": "npm run build && npm run start:dev",
    "prod": "npm run build && npm run start:prod",
    "check": "node --check lingvoman.js",
    "check:syntax": "node --check lingvoman.js && node --check libs/config.js && node --check libs/mongoose.js",
    "version:node": "node --version",
    "version:npm": "npm --version",
    "version:check": "node --version && npm --version",
    "install:all": "npm install && cd client && npm install",
    "clean": "npm run build:clean && rm -rf node_modules && cd client && rm -rf node_modules",
    "prestart": "npm run check",
    "prestart:dev": "npm run check",
    "prestart:prod": "npm run check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tamango92/Lingvoman.git"
  },
  "author": "Tamango",
  "license": "MIT",
  "devDependencies": {
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.1",
    "prettier": "^3.6.2"
  }
}
