{
  "name": "lingvoman",
  "version": "1.0.0",
  "description": "Simple system to store, serve and redact translations for site",
  "main": "app.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@vendia/serverless-express": "^4.12.6",
    "cors": "^2.8.5",
    "dotenv": "17.2.0",
    "express": "4.21.2",
    "express-rate-limit": "^8.0.1",
    "express-validator": "^7.2.1",
    "gulp": "5.0.1",
    "gulp-concat": "2.6.1",
    "gulp-ng-annotate": "^0.2.0",
    "gulp-uglify": "3.0.2",
    "helmet": "^8.1.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "9.0.2",
    "method-override": "3.0.0",
    "mongoose": "8.12.0",
    "morgan": "1.10.0",
    "nconf": "0.12.1",
    "openai": "^5.10.2",
    "winston": "^3.17.0"
  },
  "scripts": {
    "start": "node lingvoman.js",
    "start:dev": "NODE_ENV=development node -r dotenv/config lingvoman.js",
    "start:prod": "NODE_ENV=production node lingvoman.js",
    "build": "cd public && npx gulp js",
    "build:watch": "cd public && npx gulp watch",
    "dev": "npm run build && npm run start:dev",
    "dev:server": "node scripts/dev-server.js",
    "dev:watch": "npm run build:watch & npm run dev:server",
    "prod": "npm run build && npm run start:prod",
    "lint": "eslint . --config eslint.config.js",
    "lint:fix": "eslint . --config eslint.config.js --fix",
    "deploy:dev": "sam build && sam deploy --config-env default",
    "deploy:staging": "sam build && sam deploy --config-env staging",  
    "deploy:prod": "sam build && sam deploy --config-env prod",
    "deploy": "npm run deploy:dev",
    "deploy:guided": "sam build && sam deploy --guided",
    "remove": "sam delete",
    "remove:dev": "sam delete --config-env default",
    "remove:staging": "sam delete --config-env staging",
    "remove:prod": "sam delete --config-env prod",
    "logs": "sam logs -n LingvomanApi --tail",
    "logs:dev": "sam logs --stack-name lingvoman-dev -n LingvomanApi --tail",
    "logs:staging": "sam logs --stack-name lingvoman-staging -n LingvomanApi --tail",
    "logs:prod": "sam logs --stack-name lingvoman-prod -n LingvomanApi --tail",
    "sam:local": "sam local start-api --warm-containers EAGER",
    "sam:invoke": "sam local invoke LingvomanApi --event events/api-event.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tamango92/Lingvoman.git"
  },
  "author": "Tamango",
  "license": "MIT",
  "devDependencies": {
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.1",
    "prettier": "^3.6.2"
  }
}
